[sub_resource type="Shader" id="circle_shader"]
code = "shader_type canvas_item;

// Masks the minimap texture to a circle.
void fragment() {
	float r = length(UV - vec2(0.5));
	vec4 c = texture(TEXTURE, UV);
	c.a *= 1.0 - smoothstep(0.47, 0.5, r);
	COLOR = c;
}
"

[sub_resource type="ShaderMaterial" id="circle_mat"]
shader = SubResource("circle_shader")

